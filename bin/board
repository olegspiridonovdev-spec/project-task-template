#!/usr/bin/env python3
"""Render the task board as a local web page.

  bin/board                    write board.html and open it once
  bin/board serve              serve a live board on http://127.0.0.1:7777
  bin/board serve 8080         ...on another port
  bin/board serve --refresh 60 ...refreshing every 60s instead of the configured default

The served page refreshes itself in place rather than reloading: it fetches the
board, swaps the columns, and puts the scroll position back, so a page left open
on a second monitor stays where you left it. `board_refresh_sec` in config.json
sets the default interval.
"""

from __future__ import annotations

import html
import json
import sys
import time
import webbrowser
from datetime import datetime, timezone
from http.server import BaseHTTPRequestHandler, HTTPServer
from urllib.parse import parse_qs, urlparse
from pathlib import Path

sys.path.insert(0, str(Path(__file__).resolve().parent.parent / "lib"))

import tasklib as tl  # noqa: E402

# Set by `--refresh N`; otherwise config.json decides.
REFRESH_OVERRIDE: int | None = None

COLUMNS = tl.BOARD_COLUMNS

CSS = """
